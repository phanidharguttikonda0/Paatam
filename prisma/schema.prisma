datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Corporate {
  id              BigInt           @id
  name            String           @db.Text
  registration_no String           @unique @db.VarChar
  created_at      DateTime         @default(now()) @db.Timestamptz
  CorporateAdmins CorporateAdmin[]
  Branches        Branch[]
  Admins          Admin[]
}

model CorporateAdmin {
  id           BigInt    @id
  corporate_id BigInt
  name         String    @db.Text
  email        String    @unique @db.Text
  mobile       String    @unique @db.VarChar(10)
  created_at   DateTime  @default(now()) @db.Timestamptz
  Corporate    Corporate @relation(fields: [corporate_id], references: [id])

  @@index([corporate_id])
}

model Branch {
  id                  BigInt              @id
  corporate_id        BigInt
  name                String              @db.Text
  pincode             String              @db.VarChar(6)
  address             String              @db.Text
  branch_contact_mail String              @db.Text
  mobile_number       String              @db.VarChar(10)
  Corporate           Corporate           @relation(fields: [corporate_id], references: [id])
  AdminBranchAccesses AdminBranchAccess[]
  AcademicYears       AcademicYear[]
  Classes             Class[]
  Teachers            Teacher[]
  Subjects            Subject[]
}

enum AdminRole {
  DEAN
  PRINCIPAL
  VICE_PRINCIPAL
  OTHER
}

model Admin {
  id                  BigInt              @id
  corporate_id        BigInt
  admin_name          String              @db.Text
  contact_email       String              @unique @db.Text
  mobile              String              @unique @db.VarChar(10)
  role                AdminRole
  password_hash       String              @db.Text
  Corporate           Corporate           @relation(fields: [corporate_id], references: [id])
  AdminBranchAccesses AdminBranchAccess[]

  @@index([corporate_id])
}

model AdminBranchAccess {
  id        BigInt @id
  admin_id  BigInt
  branch_id BigInt
  Admin     Admin  @relation(fields: [admin_id], references: [id])
  Branch    Branch @relation(fields: [branch_id], references: [id])

  @@unique([admin_id, branch_id])
}

model AcademicYear {
  id         BigInt  @id
  branch_id  BigInt
  start_year Int
  end_year   Int
  Branch     Branch  @relation(fields: [branch_id], references: [id])
  Classes    Class[]

  @@unique([branch_id, start_year])
}

model Class {
  id               BigInt         @id
  branch_id        BigInt
  academic_year_id BigInt
  class            String         @db.VarChar(10)
  class_order      Int?
  Branch           Branch         @relation(fields: [branch_id], references: [id])
  AcademicYear     AcademicYear   @relation(fields: [academic_year_id], references: [id])
  Sections         Section[]
  ClassSubjects    ClassSubject[]

  @@unique([branch_id, academic_year_id, class])
}

model Teacher {
  id              BigInt           @id
  branch_id       BigInt
  name            String           @db.Text
  teacher_id      String           @db.Text
  password_hash   String           @db.Text
  contact_email   String           @db.Text
  contact_mobile  String           @db.Text
  Branch          Branch           @relation(fields: [branch_id], references: [id])
  Sections        Section[]
  TeacherSubjects TeacherSubject[]

  @@unique([branch_id, teacher_id])
}

model Section {
  id               BigInt       @id
  class_id         BigInt
  class_teacher_id BigInt?
  section_name     String       @db.VarChar(20)
  strength         Int
  Class            Class        @relation(fields: [class_id], references: [id])
  Teacher          Teacher?     @relation(fields: [class_teacher_id], references: [id])
  Students         Student[]
  Assignments      Assignment[]

  @@unique([class_id, section_name])
}

model Student {
  id             BigInt       @id
  section_id     BigInt
  admission_no   String       @unique @db.Text
  name           String       @db.Text
  roll_no        String       @db.Text
  password_hash  String       @db.Text
  contact_email  String?      @db.Text
  contact_mobile String?      @db.Text
  Section        Section      @relation(fields: [section_id], references: [id])
  Submissions    Submission[]

  @@unique([section_id, roll_no])
}

model Subject {
  id              BigInt           @id
  branch_id       BigInt
  name            String           @db.Text
  description     String?          @db.Text
  Branch          Branch           @relation(fields: [branch_id], references: [id])
  ClassSubjects   ClassSubject[]
  TeacherSubjects TeacherSubject[]
}

model ClassSubject {
  id         BigInt  @id
  class_id   BigInt
  subject_id BigInt
  Class      Class   @relation(fields: [class_id], references: [id])
  Subject    Subject @relation(fields: [subject_id], references: [id])

  @@unique([class_id, subject_id])
}

model TeacherSubject {
  id          BigInt       @id
  teacher_id  BigInt
  subject_id  BigInt
  Teacher     Teacher      @relation(fields: [teacher_id], references: [id])
  Subject     Subject      @relation(fields: [subject_id], references: [id])
  Assignments Assignment[]

  @@unique([teacher_id, subject_id])
}

model Assignment {
  id                 BigInt         @id
  section_id         BigInt
  teacher_subject_id BigInt
  title              String         @db.Text
  difficulty         String         @default("Medium") @db.Text
  duration_minutes   Int            @default(60)
  questions_json     Json           @default("[]")
  reasoning_model    String?        @db.Text
  status             String         @default("dispatched") @db.Text
  created_at         DateTime       @default(now()) @db.Timestamptz
  Section            Section        @relation(fields: [section_id], references: [id])
  TeacherSubject     TeacherSubject @relation(fields: [teacher_subject_id], references: [id])
  Submissions        Submission[]

  @@index([section_id, teacher_subject_id])
}

model Submission {
  id                    BigInt         @id
  assignment_id         BigInt?
  student_id            BigInt
  sample_paper_url      String?        @db.Text
  sample_paper_urls     Json           @default("[]")
  ocr_text              String?        @db.Text // extracted answer text
  score                 Decimal?       @db.Decimal
  max_score             Decimal?       @db.Decimal
  feedback              String?        @db.Text
  socratic_hint         String?        @db.Text
  ai_evaluation_json    Json?
  evaluation_provider   String?        @db.Text
  evaluation_status     String?        @db.Text
  fallback_reason       String?        @db.Text
  status                String         @default("pending_review") @db.Text
  submitted_at          DateTime       @default(now()) @db.Timestamptz
  final_score           Decimal?       @db.Decimal
  final_feedback        String?        @db.Text
  final_hint            String?        @db.Text
  final_evaluation_json Json?
  Assignment            Assignment?    @relation(fields: [assignment_id], references: [id])
  Student               Student        @relation(fields: [student_id], references: [id])
  Notifications         Notification[]

  @@index([assignment_id])
  @@index([student_id])
}

model Notification {
  id            BigInt      @id
  type          String      @db.Text
  title         String      @db.Text
  message       String      @db.Text
  details_json  Json?
  timestamp     DateTime    @default(now()) @db.Timestamptz
  submission_id BigInt?
  Submission    Submission? @relation(fields: [submission_id], references: [id])

  @@index([submission_id])
}

model RefreshToken {
  id         BigInt   @id
  token      String   @unique @db.Text
  user_id    BigInt
  user_type  String   @db.VarChar(50) // 'CORPORATE_ADMIN', 'BRANCH_ADMIN', 'TEACHER', 'STUDENT'
  expires_at DateTime @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([user_id, user_type])
}

model Otp {
  id         BigInt   @id
  email      String?  @db.Text
  mobile     String?  @db.VarChar(10)
  otp        String   @db.VarChar(6)
  expires_at DateTime @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([email])
  @@index([mobile])
}
